# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*
environments/dev/.terraform
environments/dev/.terraform/terraform.tfstate

# Terraform crash logs
crash.log
crash.*.log

# Local variable files
*.tfvars.local
*.auto.tfvars.local

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Sensitive local files
*.pem
*.key
*.secret
